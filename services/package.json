{
  "name": "services",
  "version": "1.0.0",
  "main": "dist/server.js",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "npx drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "npx drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "npx drizzle-kit push --config=drizzle.config.ts",
    "db:reset": "npx drizzle-kit reset --config=drizzle.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@neondatabase/serverless": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "redis": "^6.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
